# SourceLab Environment Variables Template (.env.example)
# DO NOT COMMIT REAL SECRETS TO GITHUB

# ==========================================
# Frontend (Next.js)
# ==========================================
# URL of the deployed recon microservice (Render / Fly.io / VPS)
NEXT_PUBLIC_RECON_URL=https://recon.yourdomain.io

# Cloudflare Turnstile Client Site Key (Optional for local testing)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAAx...

# ==========================================
# Recon Microservice (services/recon)
# ==========================================
PORT=4000
NODE_ENV=production

# Cloudflare Turnstile Server Secret Key
TURNSTILE_SECRET_KEY=0x4AAAAAAAx...

# Allowed Frontend Origins for CORS (comma-separated)
ALLOWED_ORIGINS=https://yourdomain.io,https://yourdomain.vercel.app

# Secret Salt for one-way SHA-256 hashing of client IPs in 7-day audit log
AUDIT_IP_SALT=replace-with-a-random-32-byte-hex-string

# Test Mode (Set to "true" only in test/CI environments to bypass Turnstile)
RECON_TEST_MODE=false
